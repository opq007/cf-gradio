# ===== ComfyUI =====
# 本机 ComfyUI 地址（同机默认即可）
COMFYUI_BASE_URL=http://127.0.0.1:8188
# 如果 ComfyUI 前面有鉴权网关，可填 Bearer token
COMFYUI_AUTH_TOKEN=

# ===== 工作流与产物 =====
WORKFLOWS_DIR=./workflows
OUTPUTS_DIR=./outputs

# ===== Gradio =====
# 是否生成 gradio.live 公网地址
GRADIO_SHARE=0
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
# 页面登录，格式 user:pass；不填则页面公开
GRADIO_AUTH=
GRADIO_AUTH_MESSAGE=请输入访问账号

# ===== OpenAI 接口 =====
# 设置后 /v1/* 需要 Authorization: Bearer <API_TOKEN>
API_TOKEN=
# 生成的媒体绝对 URL 前缀；留空自动使用请求的 Host（gradio.live 域名）
PUBLIC_BASE_URL=

# ===== 任务 =====
TIMEOUT_S=3600
HTTP_TIMEOUT_S=600
POLL_INTERVAL_S=0.5
MAX_UPLOAD_MB=30
MAX_IMAGE_BYTES=20000000
# 调试用：允许下载内网/回环图片 URL（默认关闭）
ALLOW_PRIVATE_IMAGE_URLS=0
INPUT_SUBDIR=cfgradio
